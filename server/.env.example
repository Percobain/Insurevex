PORT=8080
# Signs EIP-712 quotes and runs the keeper (oracle closes, settlement, coupons, NAV). Testnet key only.
QUOTER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=60000
KEEPER=1
PRICING_MARKUP=1.5
CLIENT_ORIGIN=http://localhost:3000
# Optional RPC overrides (comma-separated list replaces the built-in failover list)
# Alchemy key adds Alchemy to the Arc and Hedera failover lists (enable Hedera Testnet in the Alchemy dashboard)
ALCHEMY_API_KEY=
WHITECHAIN_RPC=
HEDERA_RPC=
ARC_RPC=

# x402 merchant: disabled by default; Hedera TESTNET only. Node >=22.13, persistent VM/local disk.
# Run npm run agent:setup once to create a dedicated wallet, pin contracts, and create an HCS audit topic.
X402_ENABLED=0
X402_MERCHANT_ACCOUNT=
X402_PUBLIC_ORIGIN=http://localhost:8080
X402_PRICE_TINYBARS=1000000
# Optional ABSOLUTE paths. Defaults are inside server/.agent-state (gitignored).
X402_STATE_FILE=
AGENT_STATE_DIR=
AGENT_POLICY_FILE=
AGENT_KILL_FILE=
# Set to 1 or create .agent-state/STOP to halt new agent payments.
AGENT_KILL_SWITCH=0
AGENT_SHARES=0.01
AGENT_DEDUCTIBLE_BPS=1000
# Wallet allowed to sign dashboard actions. Empty disables all browser controls.
# Use a separate operator/browser wallet address; never paste the agent private key into the frontend.
AGENT_CONTROLLER_ADDRESS=
# Keep 1/default for the main API; use 0 for a dedicated payment/CRE instance to avoid startup log-scan bursts.
ACTIVITY_WARMUP=1

# Optional Chainlink CRE settlement workflow. Off preserves the existing keeper.
# Turning on CHAINLINK_ENABLED alone enables validation-only mode; scoped policies wait for CRE.
CHAINLINK_ENABLED=0
# Explicit opt-in to allow the keeper to submit validated closes and settle testnet policies.
CHAINLINK_SETTLEMENT_ENABLED=0
CHAINLINK_CHAIN_IDS=1874,296
CHAINLINK_SYMBOLS=NASDAQ:NVDA,NYSEARCA:SPY
# Generate a random secret (>=32 characters); share only with the CRE workflow's secret manager.
CHAINLINK_REPORT_TOKEN=
# Optional ABSOLUTE persistent SQLite path (defaults to .chainlink-state/settlements.sqlite).
CHAINLINK_STATE_FILE=
