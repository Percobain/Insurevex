PORT=8080
# Signs EIP-712 quotes and runs the keeper (oracle closes, settlement, coupons, NAV). Testnet key only.
QUOTER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=60000
KEEPER=1
PRICING_MARKUP=1.5
CLIENT_ORIGIN=http://localhost:3000
# Optional RPC overrides
WHITECHAIN_RPC=
HEDERA_RPC=
ARC_RPC=

# x402 merchant: disabled by default; Hedera TESTNET only. Node >=22.13, persistent VM/local disk.
# Run npm run agent:setup once to create a dedicated wallet, pin contracts, and create an HCS audit topic.
X402_ENABLED=0
X402_MERCHANT_ACCOUNT=
X402_PUBLIC_ORIGIN=http://localhost:8080
X402_PRICE_TINYBARS=1000000
# Optional ABSOLUTE paths. Defaults are inside server/.agent-state (gitignored).
X402_STATE_FILE=
AGENT_STATE_DIR=
AGENT_POLICY_FILE=
AGENT_KILL_FILE=
# Set to 1 or create .agent-state/STOP to halt new agent payments.
AGENT_KILL_SWITCH=0
AGENT_SHARES=0.01
AGENT_DEDUCTIBLE_BPS=1000
